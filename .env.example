MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_DB=dsdf_fiber_ops
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta WhatsApp Cloud API. No own business number needed — use Meta's test sender.
# 9079886783 is the personal test recipient, not the Phone number ID.
WHATSAPP_BUSINESS_NUMBER=919079886783
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
